# ---------------------------------------------------------------------------
# Kulcs — környezeti változók. Másold .env.local néven, és töltsd ki.
# Az app API-kulcsok nélkül is fut: minden külső szolgáltatás MOCK módban indul.
# ---------------------------------------------------------------------------

# --- Supabase (kötelező) ----------------------------------------------------
# Helyi fejlesztésnél: `npm run db:start` után a `npm run db:status` kiírja ezeket.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# A „publishable” / anon kulcs (böngészőbe kerülhet, RLS védi az adatokat)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# A „secret” / service role kulcs — CSAK szerveren és a seedben; megkerüli az RLS-t!
SUPABASE_SERVICE_ROLE_KEY=

# Az app nyilvános címe (e-mailes linkekhez, OAuth visszatéréshez)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demó ---------------------------------------------------------------------
# Egykattintásos demó belépés a belépési oldalon. Alapértelmezés: fejlesztésben be, élesben ki.
DEMO_MODE=true
# A seed ezzel a jelszóval hozza létre a demó felhasználókat (csak helyi teszt-érték!).
DEMO_USER_PASSWORD=kulcs-demo-2026

# --- Google belépés (opcionális) ---------------------------------------------
# A Google OAuth-t a Supabase-ben kell beállítani (supabase/config.toml → [auth.external.google]).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Térkép -------------------------------------------------------------------
# Raszter csempeszerver. Az OSM alapszerver (tile.openstreetmap.org) használati szabályzata miatt éles,
# nagy forgalomra szolgáltatói csempe kell (pl. MapTiler, Stadia, saját szerver).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap-közreműködők

# --- Később (2–3. fázis) — üresen hagyva MOCK mód -------------------------------
# Anthropic Claude API (minden AI-funkció, szerveroldalon)
ANTHROPIC_API_KEY=
# Stripe (előfizetés, kreditcsomag) — teszt módú kulcsok
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Resend (tranzakciós e-mail)
RESEND_API_KEY=
EMAIL_FROM="Kulcs <hello@kulcs.app>"
# Geokódolás (cím → koordináta). Üresen a MOCK közelítő pozíciót ad; valódi Nominatim-kompatibilis szerverhez add meg az URL-t (saját példány vagy szolgáltató, a nyilvános OSM-szerver nem élesre való)
GEOCODER_URL=
